# TMDB read access token (Bearer). Required: every listing and detail page is a
# direct call from the browser to api.themoviedb.org, so without it the app
# builds fine and then answers 401 to everything.
# Create one at https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_TOKEN=your_tmdb_bearer_token_here

# The origin this deployment advertises in canonicals, the sitemap, structured
# data and shared links. Defaults to the production domain when unset, which is
# wrong for a preview deployment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics property. Optional – leave it unset and no analytics script
# is rendered at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
